# One PostgreSQL database per service; do not share schemas across services.
INVENTORY_DATABASE_URL=jdbc:postgresql://postgres:5432/inventory
INVENTORY_DATABASE_USERNAME=commerce
INVENTORY_DATABASE_PASSWORD=change-me
CART_DATABASE_URL=jdbc:postgresql://postgres:5432/cart
CART_DATABASE_USERNAME=commerce
CART_DATABASE_PASSWORD=change-me
WISHLIST_DATABASE_URL=jdbc:postgresql://postgres:5432/wishlist
WISHLIST_DATABASE_USERNAME=commerce
WISHLIST_DATABASE_PASSWORD=change-me
PROMOTION_DATABASE_URL=jdbc:postgresql://postgres:5432/promotion
PROMOTION_DATABASE_USERNAME=commerce
PROMOTION_DATABASE_PASSWORD=change-me
INVENTORY_REDIS_URL=redis://redis:6379
CART_REDIS_URL=redis://redis:6379
PROMOTION_REDIS_URL=redis://redis:6379
PRICING_BASE_URL=http://pricing-service:8084
INVENTORY_BASE_URL=http://inventory-service:8087
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
JWT_KEYS=primary=replace-with-a-long-secret
IDENTITY_TENANT_ID=default
