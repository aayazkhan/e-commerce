<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shipped from shared:common so every service that depends on it (all 25 do) picks up real
  logging without needing its own copy -- logback scans the whole runtime classpath for this
  file, not just the application module's own resources.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} [reqId=%X{requestId} traceId=%X{traceId}] - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
