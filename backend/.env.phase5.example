# One PostgreSQL database/schema per service. Use secret-manager references in production.
ORDER_DATABASE_URL=jdbc:postgresql://postgres:5432/order
PAYMENT_DATABASE_URL=jdbc:postgresql://postgres:5432/payment
SHIPPING_DATABASE_URL=jdbc:postgresql://postgres:5432/shipping
REFUND_DATABASE_URL=jdbc:postgresql://postgres:5432/refund
CHECKOUT_DATABASE_URL=jdbc:postgresql://postgres:5432/checkout
ORDER_DATABASE_USERNAME=commerce
PAYMENT_DATABASE_USERNAME=commerce
SHIPPING_DATABASE_USERNAME=commerce
REFUND_DATABASE_USERNAME=commerce
CHECKOUT_DATABASE_USERNAME=commerce
ORDER_DATABASE_PASSWORD=change-me
PAYMENT_DATABASE_PASSWORD=change-me
SHIPPING_DATABASE_PASSWORD=change-me
REFUND_DATABASE_PASSWORD=change-me
CHECKOUT_DATABASE_PASSWORD=change-me
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
JWT_KEYS=primary=replace-with-a-long-secret
IDENTITY_TENANT_ID=default
INTERNAL_SERVICE_TOKEN=replace-with-a-random-service-token
DEFAULT_WAREHOUSE_ID=warehouse-primary
CART_SERVICE_URL=http://cart-service:8088
PRICING_SERVICE_URL=http://pricing-service:8084
PROMOTION_SERVICE_URL=http://promotion-service:8090
INVENTORY_SERVICE_URL=http://inventory-service:8087
IDENTITY_SERVICE_URL=http://identity-service:8081
CATALOG_SERVICE_URL=http://catalog-service:8083
ORDER_SERVICE_URL=http://order-service:8091
PAYMENT_SERVICE_URL=http://payment-service:8092
SHIPPING_SERVICE_URL=http://shipping-service:8093
REFUND_SERVICE_URL=http://refund-service:8094
CHECKOUT_SERVICE_URL=http://checkout-service:8095
# Required for real provider-backed operation; do not use a fake provider in production.
PAYMENT_PROVIDER_BASE_URL=https://provider.example.invalid
PAYMENT_PROVIDER_API_KEY=replace-with-provider-secret
PAYMENT_PROVIDER_WEBHOOK_SECRET=replace-with-provider-webhook-secret
SHIPPING_PROVIDER_BASE_URL=https://carrier.example.invalid
SHIPPING_PROVIDER_API_KEY=replace-with-carrier-secret
SHIPPING_PROVIDER_WEBHOOK_SECRET=replace-with-carrier-webhook-secret
