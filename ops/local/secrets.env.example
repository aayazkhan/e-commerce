# Copy this file to ops/local/secrets.env (gitignored, never committed) and fill in real values.
# run-identity.sh and run-media.sh source secrets.env automatically if it exists.

# Resend (https://resend.com) -- Dashboard -> API Keys -- used for real transactional email
# (OTP codes, email verification, password reset).
export RESEND_API_KEY=""

# MSG91 (https://msg91.com) -- Dashboard -> API Keys -- used for real SMS OTP delivery.
# Sending also requires a DLT-approved OTP Template ID (Dashboard -> OTP -> Templates), an India
# SMS regulatory requirement, not a code gap. Without a template ID, SMS OTPs fall back to the
# local challenge-stub.py webhook.
export MSG91_AUTH_KEY=""
export MSG91_TEMPLATE_ID=""

# Backblaze B2 (https://backblaze.com/b2) -- S3-compatible object storage for media-service.
# These map directly onto the AWS SDK's own standard env vars (media-service uses the AWS S3
# SDK against B2's S3-compatible endpoint, no B2-specific client). Use an Application Key scoped
# to one bucket (B2 dashboard -> App Keys -> Add a New Application Key), NOT the account's
# Master Application Key -- B2's S3-compatibility layer rejects the master key's ID format
# outright ("Malformed Access Key Id"), confirmed directly against their API.
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
