# Copy this file to ops/local/secrets.env (gitignored, never committed) and fill in real values.
# run-identity.sh sources secrets.env automatically if it exists.

# Resend (https://resend.com) -- Dashboard -> API Keys -- used for real transactional email
# (OTP codes, email verification, password reset).
export RESEND_API_KEY=""

# MSG91 (https://msg91.com) -- Dashboard -> API Keys -- used for real SMS OTP delivery.
# Sending also requires a DLT-approved OTP Template ID (Dashboard -> OTP -> Templates), an India
# SMS regulatory requirement, not a code gap. Without a template ID, SMS OTPs fall back to the
# local challenge-stub.py webhook.
export MSG91_AUTH_KEY=""
export MSG91_TEMPLATE_ID=""
